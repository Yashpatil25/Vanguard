generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(USER)
  agents    Agent[]

  @@map("users")
}

model Agent {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  status              AgentStatus      @default(ACTIVE)
  dailyLimit          Int
  perTransactionLimit Int
  riskThreshold       Int              @default(70)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  events              AgentEvent[]
  user                User             @relation(fields: [userId], references: [id])
  auditLogs           AuditLog[]
  intents             IntentPassport[]
  paymentIntents      PaymentIntent[]
  policies            SpendingPolicy[]

  @@index([userId])
  @@map("agents")
}

model SpendingPolicy {
  id                   String   @id @default(cuid())
  agentId              String
  name                 String
  description          String?
  enabled              Boolean  @default(true)
  priority             Int      @default(100)
  maxTransactionAmount Int?
  dailyLimit           Int?
  allowRecurring       Boolean  @default(false)
  requireApprovalAbove Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agent                Agent    @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@map("spending_policies")
}

model IntentPassport {
  id                    String          @id @default(cuid())
  agentId               String
  originalRequest       String
  purpose               String
  category              String?
  maxAmount             Int?
  currency              String          @default("INR")
  recurringAllowed      Boolean         @default(false)
  maxTransactions       Int             @default(1)
  allowedMerchants      String?
  blockedMerchants      String?
  requiresApprovalAbove Int?
  expiresAt             DateTime
  status                IntentStatus    @default(ACTIVE)
  createdAt             DateTime        @default(now())
  agent                 Agent           @relation(fields: [agentId], references: [id])
  paymentIntents        PaymentIntent[]

  @@index([agentId])
  @@index([status])
  @@map("intent_passports")
}

model PaymentIntent {
  id             String              @id @default(cuid())
  agentId        String
  intentId       String
  merchantId     String?
  merchantName   String?
  amount         Int
  currency       String              @default("INR")
  category       String?
  purpose        String?
  recurring      Boolean             @default(false)
  status         PaymentIntentStatus @default(PENDING)
  decision       Decision?
  decisionReason String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  agent          Agent               @relation(fields: [agentId], references: [id])
  intent         IntentPassport      @relation(fields: [intentId], references: [id])
  riskAssessment RiskAssessment?
  riskSignals    RiskSignal[]
  transaction    Transaction?

  @@index([agentId])
  @@index([intentId])
  @@index([status])
  @@map("payment_intents")
}

model RiskAssessment {
  id              String        @id @default(cuid())
  paymentIntentId String        @unique
  intentScore     Int           @default(0)
  amountScore     Int           @default(0)
  merchantScore   Int           @default(0)
  behaviorScore   Int           @default(0)
  velocityScore   Int           @default(0)
  attackScore     Int           @default(0)
  totalScore      Int
  riskLevel       RiskLevel
  reasons         String?
  modelVersion    String?
  createdAt       DateTime      @default(now())
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  @@map("risk_assessments")
}

model RiskSignal {
  id              String         @id @default(cuid())
  paymentIntentId String
  type            RiskSignalType
  severity        RiskSeverity
  score           Int
  description     String
  evidence        String?
  createdAt       DateTime       @default(now())
  paymentIntent   PaymentIntent  @relation(fields: [paymentIntentId], references: [id])

  @@index([paymentIntentId])
  @@map("risk_signals")
}

model Transaction {
  id                String            @id @default(cuid())
  paymentIntentId   String            @unique
  amount            Int
  currency          String            @default("INR")
  status            TransactionStatus
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  paymentIntent     PaymentIntent     @relation(fields: [paymentIntentId], references: [id])

  @@index([status])
  @@map("transactions")
}

model AgentEvent {
  id              String     @id @default(cuid())
  agentId         String
  paymentIntentId String?
  eventType       String
  toolName        String?
  inputData       String?
  outputData      String?
  source          String?
  trustLevel      TrustLevel @default(UNTRUSTED)
  createdAt       DateTime   @default(now())
  agent           Agent      @relation(fields: [agentId], references: [id])

  @@index([agentId, createdAt])
  @@map("agent_events")
}

model AuditLog {
  id            String   @id @default(cuid())
  agentId       String?
  actorType     String
  actorId       String?
  action        String
  resourceType  String
  resourceId    String?
  previousState String?
  newState      String?
  metadata      String?
  createdAt     DateTime @default(now())
  agent         Agent?   @relation(fields: [agentId], references: [id])

  @@index([agentId, createdAt])
  @@map("audit_logs")
}

model RazorpayWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  event       String
  status      String    @default("PROCESSED")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([event])
  @@index([createdAt])
  @@map("razorpay_webhook_events")
}

enum AgentStatus {
  ACTIVE
  PAUSED
  QUARANTINED
  DISABLED
}

enum IntentStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum PaymentIntentStatus {
  PENDING
  ANALYZING
  APPROVED
  REVIEW
  BLOCKED
  EXPIRED
}

enum Decision {
  ALLOW
  REVIEW
  BLOCK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskSignalType {
  INTENT_MISMATCH
  AMOUNT_ANOMALY
  MERCHANT_ANOMALY
  VELOCITY_ANOMALY
  DUPLICATE_PAYMENT
  RECURRING_PAYMENT
  POLICY_VIOLATION
  PROMPT_INJECTION
  TOOL_POISONING
  BEHAVIORAL_DRIFT
  PAYMENT_LOOP
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionStatus {
  CREATED
  PAYMENT_PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  SIMULATOR
}

enum TrustLevel {
  TRUSTED
  SEMI_TRUSTED
  UNTRUSTED
}

enum UserRole {
  USER
  REVIEWER
  ADMIN
}
